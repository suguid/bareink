{
  "name": "bareink",
  "version": "0.1.1",
  "description": "Charts that tell the bare truth — a deterministic chart router and SVG renderer in a few kilobytes, with zero dependencies.",
  "keywords": [
    "chart",
    "svg",
    "dataviz",
    "visualization",
    "zero-dependency",
    "llm",
    "chart-recommendation"
  ],
  "license": "MIT",
  "author": "Dhan Sugui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suguid/bareink.git"
  },
  "homepage": "https://github.com/suguid/bareink#readme",
  "bugs": {
    "url": "https://github.com/suguid/bareink/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./route": {
      "types": "./dist/route.d.ts",
      "default": "./dist/route.js"
    },
    "./validate": {
      "types": "./dist/validate.d.ts",
      "default": "./dist/validate.js"
    },
    "./schema.json": "./schema.json",
    "./locale/en": {
      "types": "./dist/locale/en.d.ts",
      "default": "./dist/locale/en.js"
    },
    "./locale/pt-BR": {
      "types": "./dist/locale/pt-BR.d.ts",
      "default": "./dist/locale/pt-BR.js"
    },
    "./package.json": "./package.json",
    "./iife": "./dist/bareink.iife.js"
  },
  "bin": {
    "bareink-mcp": "./bin/bareink-mcp.js"
  },
  "unpkg": "./dist/bareink.iife.js",
  "jsdelivr": "./dist/bareink.iife.js",
  "files": [
    "bin",
    "dist",
    "schema.json",
    "llms.txt",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "size": "node scripts/size.mjs",
    "example": "node examples/build.ts",
    "readme": "node examples/readme.ts",
    "site": "node site/build.ts"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@11.13.1"
}
